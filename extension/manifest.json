{
  "manifest_version": 3,
  "name": "课点 · B站学习进度",
  "version": "2.2.1",
  "description": "本地发现 B 站浏览记录，并跟踪真实播放进度",
  "permissions": [
    "history",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.bilibili.com/video/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://bilibili.com/video/*"
      ],
      "js": [
        "metadata.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "课点 · 配对与同步",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "minimum_chrome_version": "111"
}
